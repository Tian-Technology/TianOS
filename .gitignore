# ==========================================
# 1. Python 缓存与编译文件（绝对不能传）
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 2. 虚拟环境（体积巨大，绝对不传）
# ==========================================
venv/
ENV/
env/
.env

# ==========================================
# 3. 编辑器与系统配置（每个人不一样，不传）
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# 4. 日志与临时测试文件（如果不需要可以删掉）
# ==========================================
*.log
*.txt
*.docx
_probe*
_t.png
r.txt

# ==========================================
# 5. 打包与编译生成的二进制文件（千万不能传！）
# ==========================================
*.exe
*.spec
*.bin
*.iso

# ==========================================
# 6. PyInstaller 打包目录
# ==========================================
# 如果你有专门打包的文件夹可以在这里排除
# dist/
# build/